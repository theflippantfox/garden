# --- Notes source ---
# "mock" reads from ./notes on disk (development).
# "github" reads via the GraphQL client (production).
NOTES_SOURCE=mock

# Used only when NOTES_SOURCE=mock
NOTES_DIR=notes

# --- GitHub (only needed when NOTES_SOURCE=github) ---
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# --- Webhook ---
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# --- Access control ---
# Required for /api/cache admin endpoints and to view private notes.
# Set to any random string; clients send it as: Authorization: Bearer ${GARDEN_TOKEN}
GARDEN_TOKEN=

# --- Local dev ---
# Set to "true" to allow POST /api/webhook?dev=1 to skip signature verification.
# MUST be unset (or "false") in production.
ALLOW_DEV_WEBHOOK=true